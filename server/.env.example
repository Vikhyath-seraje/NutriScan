# ============================================================
#  NutriScan — Server Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ---
# Get this from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nutriscan?retryWrites=true&w=majority

# --- JWT ---
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- Google Gemini ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- USDA FoodData Central ---
# Get a free key from: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key_here
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# --- Cloudinary (optional — for image hosting) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- CORS ---
# Frontend dev URL
CLIENT_URL=http://localhost:5173

