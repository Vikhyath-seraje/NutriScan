# .gitignore
# ---------------------------------------------------------
# Files that must NEVER be committed to version control.
# ---------------------------------------------------------

# Environment variables (contain API keys and secrets!)
.env
.env.local
.env.production

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite build output
client/dist/
client/.vite/

# OS junk
.DS_Store
Thumbs.db

# Uploaded files (stored locally during dev, use Cloudinary in prod)
server/uploads/

# IDE files
.vscode/
.idea/

# Test coverage
coverage/

